{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyframe",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat is required: Prisma, NextAuth and `pg` all use Node APIs.
  "compatibility_flags": ["nodejs_compat"],

  // Static output (prerendered pages, /_next/static, /public) served straight
  // from Cloudflare's edge; only dynamic routes reach the Worker.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Served only on the custom domains below (no duplicate *.workers.dev copy).
  "workers_dev": false,

  // Non-secret runtime config. Secrets go in via `wrangler secret`
  // (scripts/setup-secrets.ps1), never in this file.
  "vars": {
    "NEXTAUTH_URL": "https://www.easyframe.app"
  },

  // Custom domains: Cloudflare creates and manages the DNS records + certs.
  // next.config.mjs 308-redirects the apex to www.
  "routes": [
    { "pattern": "www.easyframe.app", "custom_domain": true },
    { "pattern": "easyframe.app", "custom_domain": true }
  ],

  // Pooled connection to the existing production Postgres.
  // Create it once with your own connection string (see MIGRATION-CLOUDFLARE.md):
  //   npx wrangler hyperdrive create easyframe-db --connection-string="postgres://..."
  // then paste the returned id below.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7100bfe82eae4ae68e6806efa0809abe",
      // Local emulation only (`wrangler dev`, `cf:preview`, and the deploy
      // command's env probe). Not a real credential; production always uses
      // the Hyperdrive config above.
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/easyframe"
    }
  ]
}
